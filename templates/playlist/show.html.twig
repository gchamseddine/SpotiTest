{% extends 'base.html.twig' %}

{% block title %}
    {{ playlist.name }} - SpotiTest
{% endblock %}

{% block stylesheets %}
    <link
        rel="stylesheet"
        href="{{ asset('css/setup.css') }}"
    >
{% endblock %}

{% block body %}

    <div class="setup-page">

        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                {{ message }}
            </div>
        {% endfor %}

        <div class="setup-container">

            <a
                href="{{ path('home') }}"
                class="back-link"
            >
                ← Back to Playlists
            </a>

            <div class="setup-card">

                <div class="playlist-summary">

                    {% if playlist.images is not empty %}
                        <img
                            src="{{ playlist.images[0].url }}"
                            alt="{{ playlist.name }}"
                            class="setup-playlist-cover"
                        >
                    {% endif %}

                    <div class="playlist-summary-info">

                        <h1>{{ playlist.name }}</h1>

                        <p>
                            {{ totalSongs }}
                            playable
                            {{ totalSongs == 1 ? 'song' : 'songs' }}
                        </p>

                    </div>

                </div>


                {% if totalSongs > 0 %}

                    <div class="game-settings">

                        <h2>Game Settings</h2>

                        <form
                            method="POST"
                            action="{{ path('quiz_start', {id: playlist.id}) }}"
                            class="settings-form"
                        >

                            <div class="setting-group">

                                <div class="setting-heading">

                                    <label for="rounds">
                                        Number of rounds
                                    </label>

                                    <span>
                                    Maximum: {{ totalSongs }}
                                </span>

                                </div>

                                <input
                                    type="number"
                                    id="rounds"
                                    name="rounds"
                                    value="{{ totalSongs < 10 ? totalSongs : 10 }}"
                                    min="1"
                                    max="{{ totalSongs }}"
                                    required
                                    class="number-input"
                                >

                            </div>


                            <div class="setting-group">

                                <div class="setting-heading">

                                    <label for="clipLength">
                                        Clip length
                                    </label>

                                    <span id="clipLengthValue">
                                    30 seconds
                                </span>

                                </div>

                                <input
                                    type="range"
                                    id="clipLength"
                                    name="clipLength"
                                    min="5"
                                    max="30"
                                    value="30"
                                    step="5"
                                    class="range-input"
                                >

                            </div>


                            <div class="setting-group">

                                <p class="setting-label">
                                    What do you want to guess?
                                </p>

                                <div class="guess-options">

                                    <label class="guess-option">

                                        <input
                                            type="radio"
                                            name="guessMode"
                                            value="both"
                                            checked
                                        >

                                        <span>Song & Artist</span>

                                    </label>


                                    <label class="guess-option">

                                        <input
                                            type="radio"
                                            name="guessMode"
                                            value="artist"
                                        >

                                        <span>Artist</span>

                                    </label>


                                    <label class="guess-option">

                                        <input
                                            type="radio"
                                            name="guessMode"
                                            value="title"
                                        >

                                        <span>Song</span>

                                    </label>

                                </div>

                            </div>


                            <button
                                type="submit"
                                class="button button-primary start-button"
                            >
                                Start Quiz
                            </button>

                        </form>

                    </div>

                {% else %}

                    <div class="empty-playlist">

                        <p>
                            This playlist has no playable songs
                            available for SpotiTest.
                        </p>

                    </div>

                {% endif %}

            </div>

        </div>

    </div>


    <script>
        const clipLength =
            document.getElementById('clipLength');

        const clipLengthValue =
            document.getElementById('clipLengthValue');

        if (clipLength && clipLengthValue) {
            clipLength.addEventListener(
                'input',
                function () {
                    clipLengthValue.textContent =
                        this.value + ' seconds';
                }
            );
        }
    </script>

{% endblock %}
