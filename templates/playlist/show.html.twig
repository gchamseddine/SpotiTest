{% extends 'base.html.twig' %}

{% block title %}
    {{ playlist.name }} - SpotiTest
{% endblock %}

{% block body %}

    <a href="/">← Back</a>

    <br><br>

    {% if playlist.images is not empty %}
        <img
            src="{{ playlist.images[0].url }}"
            width="250"
            alt="{{ playlist.name }}"
        >
    {% endif %}

    <h1>{{ playlist.name }}</h1>

    <p>{{ totalSongs }} songs</p>

    <button type="button">
        Start Quiz
    </button>

{% endblock %}
