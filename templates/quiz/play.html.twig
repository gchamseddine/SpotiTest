{% extends 'base.html.twig' %}

{% block title %}Quiz - SpotiTest{% endblock %}

{% block stylesheets %}
    <link
        rel="stylesheet"
        href="{{ asset('css/quiz.css') }}"
    >
{% endblock %}

{% block body %}

    <div class="quiz-page">

        <header class="quiz-header">

            <a href="{{ path('home') }}" class="quiz-logo">
                SpotiTest
            </a>

            <button
                id="quit-button"
                type="button"
                class="quit-button"
            >
                Quit Game
            </button>

        </header>


        <main class="quiz-content">

            <div class="round-label">
                ROUND
            </div>

            <h1 id="round-heading" class="round-heading">
                {{ round }} / {{ totalRounds }}
            </h1>


            <div class="timer-area">

                <p id="timer" class="timer">
                    {{ clipLength }} seconds
                </p>

            </div>


            <p
                id="round-answer"
                class="round-answer"
                style="display: none;"
            ></p>


            <div
                id="answers"
                class="answers"
                style="display: none;"
            >

                <label
                    for="guess-answer"
                    class="guess-label"
                >
                    Your Guess
                </label>

                <input
                    type="text"
                    id="guess-answer"
                    class="guess-input"
                    autocomplete="off"
                    placeholder="Song title or artist"
                >


                <div class="answer-statuses">

                    {% if guessMode == 'both' or guessMode == 'title' %}

                        <p
                            id="title-status"
                            class="answer-status"
                        >
                            Song: ?
                        </p>

                    {% endif %}


                    {% if guessMode == 'both' or guessMode == 'artist' %}

                        <p
                            id="artist-status"
                            class="answer-status"
                        >
                            Artist: ?
                        </p>

                    {% endif %}

                </div>

            </div>


            <p id="status" class="game-status"></p>


            <div class="quiz-controls">

                <button
                    id="skip-button"
                    type="button"
                    class="button button-secondary skip-button"
                    style="display: none;"
                >
                    Skip
                </button>

            </div>

        </main>

    </div>

    <script>
        window.spotiTestQuiz = {
            clipLength: {{ clipLength }},
            trackUri: {{ trackUri|json_encode|raw }},
            round: {{ round }},
            totalRounds: {{ totalRounds }},
            guessMode: {{ guessMode|json_encode|raw }},

            urls: {
                spotifyToken: {{ path('spotify_token')|json_encode|raw }},
                roundStart: {{ path('quiz_round_start')|json_encode|raw }},
                answer: {{ path('quiz_answer')|json_encode|raw }},
                next: {{ path('quiz_next')|json_encode|raw }},
                quit: {{ path('quiz_quit')|json_encode|raw }}
            }
        };
    </script>

    <script src="https://sdk.scdn.co/spotify-player.js"></script>
    <script src="{{ asset('js/quiz.js') }}"></script>

{% endblock %}
