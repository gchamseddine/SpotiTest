{% extends 'base.html.twig' %}

{% block title %}Quiz - SpotiTest{% endblock %}

{% block body %}

    <h1>SpotiTest</h1>

    <h2>
        Round {{ round }} / {{ totalRounds }}
    </h2>

    <p id="timer">
        {{ clipLength }} seconds
    </p>


    <div id="answers" style="display: none;">

        <label for="guess-answer">Guess</label>

        <input
            type="text"
            id="guess-answer"
            autocomplete="off"
            placeholder="Song title or artist"
        >

        <div>
            {% if guessMode == 'both' or guessMode == 'title' %}
                <p id="title-status">Song: ?</p>
            {% endif %}

            {% if guessMode == 'both' or guessMode == 'artist' %}
                <p id="artist-status">Artist: ?</p>
            {% endif %}
        </div>

    </div>

    <p id="status"></p>

    <button
        id="give-up-button"
        type="button"
        style="display: none;"
    >
        Give Up
    </button>

    <script src="https://sdk.scdn.co/spotify-player.js"></script>

    <script>
        let spotifyPlayer;
        let spotifyDeviceId;
        let countdownInterval;
        let roundStarted = false;

        let titleSolved = false;
        let artistSolved = false;

        let checkTimeout;

        const clipLength = {{ clipLength }};

        const timer = document.getElementById('timer');
        const answers = document.getElementById('answers');
        const status = document.getElementById('status');
        const giveUpButton = document.getElementById('give-up-button');

        const guessInput =
            document.getElementById('guess-answer');

        const titleStatus =
            document.getElementById('title-status');

        const artistStatus =
            document.getElementById('artist-status');


        async function getSpotifyToken() {

            const response = await fetch(
                '{{ path('spotify_token') }}'
            );

            if (!response.ok) {
                throw new Error(
                    'Could not retrieve Spotify token'
                );
            }

            const data = await response.json();

            return data.access_token;
        }


        window.onSpotifyWebPlaybackSDKReady = () => {

            spotifyPlayer = new Spotify.Player({
                name: 'SpotiTest',

                getOAuthToken: async callback => {
                    try {
                        const token =
                            await getSpotifyToken();

                        callback(token);

                    } catch (error) {
                        console.error(error);
                    }
                },

                volume: 0.5
            });


            spotifyPlayer.addListener(
                'ready',
                async ({ device_id }) => {

                    spotifyDeviceId = device_id;

                    await startRound();
                }
            );


            spotifyPlayer.addListener(
                'authentication_error',
                ({ message }) => {
                    console.error(message);
                }
            );


            spotifyPlayer.addListener(
                'account_error',
                ({ message }) => {
                    console.error(message);
                }
            );


            spotifyPlayer.addListener(
                'playback_error',
                ({ message }) => {
                    console.error(message);
                }
            );


            spotifyPlayer.connect();
        };


        async function startRound() {

            if (roundStarted) {
                return;
            }

            roundStarted = true;

            answers.style.display = 'block';
            giveUpButton.style.display = 'block';

            guessInput.focus();

            try {
                const token = await getSpotifyToken();

                const response = await fetch(
                    'https://api.spotify.com/v1/me/player/play'
                    + '?device_id='
                    + encodeURIComponent(spotifyDeviceId),
                    {
                        method: 'PUT',

                        headers: {
                            'Authorization': 'Bearer ' + token,
                            'Content-Type': 'application/json'
                        },

                        body: JSON.stringify({
                            uris: [
                                {{ trackUri|json_encode|raw }}
                            ]
                        })
                    }
                );

                if (!response.ok) {
                    status.textContent =
                        'Could not start Spotify playback.';

                    return;
                }

                startCountdown();

            } catch (error) {
                console.error(error);

                status.textContent =
                    'Could not start Spotify playback.';
            }
        }


        function startCountdown() {

            let secondsLeft = clipLength;

            timer.textContent =
                secondsLeft + ' seconds';


            countdownInterval = setInterval(
                async () => {

                    secondsLeft--;

                    timer.textContent =
                        secondsLeft + ' seconds';


                    if (secondsLeft <= 0) {

                        timer.textContent = 'Time up!';

                        await finishRound();
                    }

                },
                1000
            );
        }


        guessInput.addEventListener(
            'input',
            () => {

                clearTimeout(checkTimeout);

                checkTimeout = setTimeout(
                    checkGuess,
                    250
                );
            }
        );


        async function checkGuess() {

            const guess =
                guessInput.value.trim();

            if (guess === '') {
                return;
            }


            const response = await fetch(
                '{{ path('quiz_answer') }}',
                {
                    method: 'POST',

                    headers: {
                        'Content-Type':
                            'application/json'
                    },

                    body: JSON.stringify({
                        guess: guess
                    })
                }
            );


            if (!response.ok) {
                return;
            }


            const result =
                await response.json();


            if (
                result.titleCorrect === true &&
                !titleSolved
            ) {

                titleSolved = true;

                if (titleStatus) {
                    titleStatus.textContent =
                        'Song: ' + guess + ' ✓';
                }

                guessInput.value = '';
            }


            if (
                result.artistCorrect === true &&
                !artistSolved
            ) {

                artistSolved = true;

                if (artistStatus) {
                    artistStatus.textContent =
                        'Artist: ' + guess + ' ✓';
                }

                guessInput.value = '';
            }


            checkRoundComplete();
        }


        async function checkRoundComplete() {

            let complete = false;

            {% if guessMode == 'both' %}
            complete =
                titleSolved &&
                artistSolved;
            {% elseif guessMode == 'title' %}
            complete =
                titleSolved;
            {% elseif guessMode == 'artist' %}
            complete =
                artistSolved;
            {% endif %}


            if (!complete) {
                return;
            }

            timer.textContent = 'Correct!';
            status.textContent = 'You got it!';

            await finishRound();
        }

        let roundEnded = false;

        async function finishRound() {

            if (roundEnded) {
                return;
            }

            roundEnded = true;

            clearInterval(countdownInterval);

            await spotifyPlayer.pause();

            disableAnswers();

            giveUpButton.disabled = true;

            const response = await fetch(
                '{{ path('quiz_next') }}',
                {
                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify({
                        lastGuess: guessInput.value.trim()
                    })
                }
            );

            if (response.redirected) {
                window.location.href = response.url;
            } else {
                window.location.href =
                    '{{ path('quiz_play') }}';
            }
        }

        giveUpButton.addEventListener(
            'click',
            async () => {

                status.textContent = 'Gave up!';

                await finishRound();
            }
        );

        function disableAnswers() {

            guessInput.disabled = true;
        }

    </script>

{% endblock %}
