{% extends 'base.html.twig' %}

{% block title %}Results - SpotiTest{% endblock %}

{% block stylesheets %}
    <link
        rel="stylesheet"
        href="{{ asset('css/results.css') }}"
    >
{% endblock %}

{% block body %}

    <div class="results-page">

        <header class="results-header">

            <a href="{{ path('home') }}" class="results-logo">
                SpotiTest
            </a>

        </header>


        <main class="results-content">

            <div class="results-intro">

                <p class="complete-label">
                    QUIZ COMPLETE
                </p>

                <h1>Nice work!</h1>

                <div class="final-score">

                    <span>Score</span>

                    <strong>
                        {{ game.score }}
                    </strong>

                </div>

            </div>


            <section class="round-results">

                <h2>Round Results</h2>

                <div class="results-list">

                    {% for result in game.results %}

                        <article class="result-card">

                            <h3>
                                Round {{ loop.index }}
                            </h3>


                            {% if game.guessMode == 'both'
                                or game.guessMode == 'title' %}

                                <div class="result-row">

                                <span class="result-label">
                                    Song
                                </span>

                                    <span class="result-value">

                                    {{ result.title }}

                                        {% if result.titleCorrect %}
                                            <span class="correct-mark">
                                            ✓
                                        </span>
                                        {% endif %}

                                </span>

                                </div>

                            {% endif %}


                            {% if game.guessMode == 'both'
                                or game.guessMode == 'artist' %}

                                <div class="result-row">

                                <span class="result-label">
                                    Artist
                                </span>

                                    <span class="result-value">

                                    {{ result.artists|join(', ') }}

                                        {% if result.artistCorrect %}
                                            <span class="correct-mark">
                                            ✓
                                        </span>
                                        {% endif %}

                                </span>

                                </div>

                            {% endif %}

                        </article>

                    {% endfor %}

                </div>

            </section>


            <div class="results-actions">

                <form
                    action="{{ path('quiz_retry') }}"
                    method="post"
                >
                    <button
                        type="submit"
                        class="button button-primary retry-button"
                    >
                        Retry
                    </button>
                </form>

                <div class="secondary-actions">

                    <a
                        href="{{ path(
                            'playlist_show',
                            {id: game.playlistId}
                        ) }}"
                        class="button button-secondary"
                    >
                        Back to Playlist
                    </a>

                    <a
                        href="{{ path('home') }}"
                        class="button button-secondary"
                    >
                        Back to Home
                    </a>

                </div>

            </div>

        </main>

    </div>

{% endblock %}
