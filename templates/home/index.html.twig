{% extends 'base.html.twig' %}

{% block title %}SpotiTest{% endblock %}

{% block body %}
    <h1>SpotiTest</h1>

    {% if spotifyConnected %}
        <p>Connected to Spotify</p>

        <a href="{{ path('spotify_logout') }}">
            Logout
        </a>

        <h2>Your Playlists</h2>

        {% for playlist in userPlaylists %}
            <div>
                {% if playlist.images is not empty %}
                    <img
                        src="{{ playlist.images[0].url }}"
                        width="150"
                        alt="{{ playlist.name }}"
                    >
                {% endif %}

                <h3>
                    <a href="{{ path('playlist_show', {id: playlist.id}) }}">
                        {{ playlist.name }}
                    </a>
                </h3>

                {% if playlist.items is defined %}
                    <p>{{ playlist.items.total }} songs</p>
                {% endif %}
            </div>
        {% else %}
            <p>No playlists found.</p>
        {% endfor %}

    {% else %}
        <a href="{{ path('spotify_login') }}">
            Login with Spotify
        </a>
    {% endif %}

    <br><br>

    <input
        id="playlist-search"
        type="text"
        placeholder="Search Spotify playlists"
    >

    <button id="search-button">Search</button>

    <div id="results"></div>

    <script>
        const searchInput = document.getElementById('playlist-search');
        const searchButton = document.getElementById('search-button');
        const results = document.getElementById('results');

        searchButton.addEventListener('click', async () => {
            const query = searchInput.value.trim();

            if (query === '') {
                return;
            }

            results.innerHTML = 'Searching...';

            const response = await fetch(
                '/api/spotify/playlists?q=' + encodeURIComponent(query)
            );

            const data = await response.json();

            results.innerHTML = '';

            const playlists = data.playlists.items.filter(
                playlist => playlist !== null
            );

            playlists.forEach(playlist => {
                const div = document.createElement('div');

                div.innerHTML = `
                    <a href="/playlist/${playlist.id}">
                        <img
                            src="${playlist.images[0]?.url ?? ''}"
                            width="150"
                            alt="${playlist.name}"
                        >

                        <h2>${playlist.name}</h2>
                    </a>

                    <p>By ${playlist.owner.display_name}</p>
                    <p>${playlist.items.total} songs</p>
                `;

                results.appendChild(div);
            });
        });
    </script>
{% endblock %}
