{% extends 'base.html.twig' %}

{% block title %}SpotiTest{% endblock %}

{% block body %}

    {% for message in app.flashes('error') %}
        <p>{{ message }}</p>
    {% endfor %}

    <h1>SpotiTest</h1>

    <h2>SpotiTest Account</h2>

    {% if app.user %}
        <p>
            Logged in as <strong>{{ app.user.username }}</strong>
        </p>

        <a href="{{ logout_path() }}">
            Log Out
        </a>
    {% else %}
        <p>
            You can play without creating an account.
        </p>

        <a href="{{ path('app_login') }}">
            Log In
        </a>

        <a href="{{ path('app_register') }}">
            Create Account
        </a>
    {% endif %}

    <h2>Spotify</h2>

    {% if spotifyConnected %}
        <p>Connected to Spotify</p>

        <a href="{{ path('spotify_login', {switch: 1}) }}">
            Switch Spotify Account
        </a>

        <br>

        <a href="{{ path('spotify_logout') }}">
            Disconnect Spotify
        </a>

        <h3>Your Playlists</h3>

        {% for playlist in userPlaylists %}
            <div>
                {% if playlist.images is not empty %}
                    <img
                        src="{{ playlist.images[0].url }}"
                        width="150"
                        alt="{{ playlist.name }}"
                    >
                {% endif %}

                <h3>
                    <a href="{{ path('playlist_show', {id: playlist.id}) }}">
                        {{ playlist.name }}
                    </a>
                </h3>

            </div>
        {% else %}
            <p>No playlists found.</p>
        {% endfor %}

    {% else %}
        <a href="{{ path('spotify_login') }}">
            Connect Spotify
        </a>
    {% endif %}

{% endblock %}
