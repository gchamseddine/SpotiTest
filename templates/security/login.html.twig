{% extends 'base.html.twig' %}

{% block title %}Login - SpotiTest{% endblock %}

{% block stylesheets %}
    <link
        rel="stylesheet"
        href="{{ asset('css/auth.css') }}"
    >
{% endblock %}

{% block body %}

    <div class="auth-page">

        <header class="auth-header">

            <a href="{{ path('home') }}" class="auth-logo">
                SpotiTest
            </a>

            <a href="{{ path('home') }}" class="back-home">
                Back to Home
            </a>

        </header>


        <main class="auth-content">

            <div class="auth-card">

                <div class="auth-intro">

                    <p class="auth-label">
                        WELCOME BACK
                    </p>

                    <h1>Log in to SpotiTest</h1>

                    <p>
                        Access your saved high scores.
                    </p>

                </div>


                {% if error %}

                    <div class="alert alert-error">
                        {{ error.messageKey|trans(
                            error.messageData,
                            'security'
                        ) }}
                    </div>

                {% endif %}


                {% if app.user %}

                    <div class="already-logged-in">

                        <p>
                            You are logged in as
                            <strong>
                                {{ app.user.userIdentifier }}
                            </strong>.
                        </p>

                        <a
                            href="{{ logout_path() }}"
                            class="button button-secondary"
                        >
                            Log Out
                        </a>

                    </div>

                {% else %}

                    <form
                        method="post"
                        class="auth-form"
                    >

                        <div class="form-group">

                            <label for="username">
                                Username
                            </label>

                            <input
                                type="text"
                                value="{{ last_username }}"
                                name="_username"
                                id="username"
                                autocomplete="username"
                                required
                                autofocus
                                class="auth-input"
                            >

                        </div>


                        <div class="form-group">

                            <label for="password">
                                Password
                            </label>

                            <input
                                type="password"
                                name="_password"
                                id="password"
                                autocomplete="current-password"
                                required
                                class="auth-input"
                            >

                        </div>


                        <input
                            type="hidden"
                            name="_csrf_token"
                            data-controller="csrf-protection"
                            value="{{ csrf_token('authenticate') }}"
                        >


                        <button
                            class="button button-primary auth-submit"
                            type="submit"
                        >
                            Log In
                        </button>

                    </form>


                    <p class="auth-switch">
                        Don't have an account?

                        <a href="{{ path('app_register') }}">
                            Create one
                        </a>
                    </p>

                {% endif %}

            </div>

        </main>

    </div>

{% endblock %}
